{
  "name": "rh-stockpair-oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Stock-pair pricing oracle for Robinhood Chain (4663). Deterministic data path.",
  "scripts": {
    "verify:addresses": "node --env-file-if-exists=.env --import tsx scripts/verify-addresses.ts",
    "registry:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-registry.ts",
    "index:backfill": "node --env-file-if-exists=.env --import tsx scripts/backfill.ts",
    "index:watch": "node --env-file-if-exists=.env --import tsx scripts/watch.ts",
    "serve": "node --env-file-if-exists=.env --import tsx scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "corporate:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-corporate.ts",
    "agent:scan": "node --env-file-if-exists=.env --import tsx scripts/agent-scan.ts",
    "agent:queue": "node --env-file-if-exists=.env --import tsx scripts/agent-queue.ts",
    "agent:approve": "node --env-file-if-exists=.env --import tsx scripts/agent-decide.ts approve",
    "agent:reject": "node --env-file-if-exists=.env --import tsx scripts/agent-decide.ts reject",
    "agent:publish": "node --env-file-if-exists=.env --import tsx scripts/agent-publish.ts",
    "index:backfill:v3": "node --env-file-if-exists=.env --import tsx scripts/backfill.ts --v3",
    "crosscheck": "node --env-file-if-exists=.env --import tsx scripts/crosscheck.ts",
    "volume:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-volume.ts",
    "holders:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-holders.ts",
    "agent:listen": "node --env-file-if-exists=.env --import tsx scripts/agent-listen.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "viem": "^2.56.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
