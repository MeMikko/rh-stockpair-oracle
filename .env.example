# ---- RPC ----
#
# Two endpoints, because they have opposite strengths. Measured 2026-09-02:
#
#   - Alchemy's free tier caps eth_getLogs at a 10 BLOCK range, which makes a
#     52M-block backfill 5.2M requests. But it has archive state, which the
#     public endpoint does not.
#   - The public endpoint has no block-range cap at all -- a 200,000-block
#     range returns in ~1.3s -- but keeps no archive state.
#
# So: state reads go to Alchemy, log reads go to the public endpoint. Leaving
# both of the following unset gives exactly that.

# State and archive reads. Expanded into the Alchemy endpoint automatically.
ALCHEMY_API_KEY=

# Overrides ALCHEMY_API_KEY entirely when set. Leave it COMMENTED unless you
# have a specific reason -- setting it to the public endpoint silently
# disables Alchemy and with it all archive access.
# RH_RPC_URL=

# Endpoint for eth_getLogs. Defaults to the public one, which is the right
# choice; only set this if you have something better than 200k-block ranges.
# RH_LOGS_RPC_URL=

# Optional second endpoint; used as failover on read errors.
RH_RPC_FALLBACK_URL=https://rpc.mainnet.chain.robinhood.com

# Blocks per eth_getLogs call, and how many run in parallel. The defaults
# (200000 x 8) walk the whole chain in about four minutes. Do NOT set 1000
# here -- an earlier version of this file did, on the mistaken belief that the
# public endpoint capped ranges near 1000, and it makes the backfill 200x
# slower. The walker adapts downward on its own where the chain is dense.
# RH_LOG_CHUNK=200000
# RH_LOG_CONCURRENCY=8

# SQLite path for v1. Swap for Postgres later via src/db.
DB_PATH=./data/oracle.db

# API
PORT=8080

# ---- Phase 3: public agent ----
# Bankr LLM Gateway (Anthropic-format). Used ONLY to phrase a post; never in
# the data path. Without a key the agent falls back to deterministic templates.
#
# THIS KEY MUST BE GATEWAY-ONLY. A Bankr key carries independent capability
# flags, and one key can hold all of them. This process attaches its key to a
# request whose body contains text a stranger wrote, so generate a key at
# bankr.bot/api-keys with LLM Gateway ENABLED and Wallet API, Agent API and
# Token Launch API OFF. `readOnly` does not restrict the gateway; leave it on.
# Check what the key can really do with: npm run bankr:scope
BANKR_LLM_BASE_URL=https://llm.bankr.bot
BANKR_LLM_KEY=
BANKR_LLM_MODEL=claude-sonnet-5

# Channels to queue drafts for (csv): farcaster,x
AGENT_CHANNELS=farcaster

# Recorded against every approval so the queue shows who authorised a post.
AGENT_APPROVER=

# Farcaster via Neynar. Publishing also requires an approved post AND --live.
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=

# X / Twitter (OAuth 1.0a). Publisher is not implemented yet; dry run only.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---- Blockscout: second data source ----
# Backfill path that does not depend on Alchemy, plus holder counts and token
# metadata that no RPC call returns. Never a pricing input.
BLOCKSCOUT_BASE_URL=https://robinhoodchain.blockscout.com
BLOCKSCOUT_API_KEY=
# Min ms between explorer calls; raised automatically on 429.
BLOCKSCOUT_MIN_INTERVAL_MS=120

# FID of the agent's own Farcaster account. Needed to read mentions; replies
# still require approval and --live like any other post.
NEYNAR_AGENT_FID=

# Bind address. Leave unset for local dev (all interfaces). Production sets
# 127.0.0.1 so the reverse proxy is the only way in.
# HOST=127.0.0.1

# ---- Pricing ----
# 'launch' serves every route without charge while still publishing what it
# will cost. 'paid' only once a payment path is actually wired up.
PRICING_MODE=launch
# Stable per-install salt for hashing caller addresses in the usage counter.
# Set it once; changing it resets caller identity, not the counts.
USAGE_SALT=

# Header carrying the true client address when a CDN sits in front, e.g.
# cf-connecting-ip behind Cloudflare. Only honoured when set -- a forwarded
# header is caller-controlled, so it is never trusted by default. Restrict the
# reverse proxy to the CDN's ranges as well.
TRUSTED_CLIENT_IP_HEADER=

# ---- Autonomous replies ----
# 'off' (default) queues every reply for a person, exactly like a broadcast.
# 'pro' answers a mention from an entitled FID directly, and only that case.
# Broadcasts stay gated on a human regardless of this setting.
AGENT_AUTONOMOUS_REPLIES=off
# Bounds on the autonomous path. Both are rolling 24h windows.
AGENT_AUTO_REPLY_PER_FID_DAILY=10
AGENT_AUTO_REPLY_DAILY_CAP=50

# Shared secret from the Neynar webhook dashboard. The signature check is the
# security boundary for autonomous replies: without it, anyone could POST a
# forged cast.created naming an entitled FID. Unset disables the endpoint.
NEYNAR_WEBHOOK_SECRET=

# ---- Dashboard sign-in ----
# Signing key for session tokens. No default on purpose: a shared fallback
# would let anyone mint a session for any address. 32+ random hex chars.
AUTH_SECRET=
# Shown in the message the user signs, so they can see what they are signing.
AUTH_DOMAIN=oracle.sb4s.xyz

# ---- Pro payments (Base USDC) ----
BASE_RPC_URL=https://mainnet.base.org

# Token-gated access is designed in but dormant: leave unset until a token
# exists. A placeholder address would produce a check that gates nothing.
PRO_TOKEN_ADDRESS=
PRO_TOKEN_MIN_BALANCE=

# ---- x402: two doors ----
#
# Bankr's x402 offering is a HOSTED GATEWAY, not a facilitator. Bankr issues
# the 402 itself, takes the USDC on Base, settles it, and forwards the paid
# request here. There is no public /verify + /settle API for other people's
# servers, so X402_FACILITATOR_URL must never point at Bankr -- that would 402
# every caller with an error about signatures. See x402/README.md.

# Door 1: Bankr's gateway in front of this origin.
#
# The URL is documentation only -- this process never calls it. It is
# advertised in the 402 body and in /.well-known/agent.json so a caller that
# already pays through Bankr is told where to call.
X402_GATEWAY_URL=https://x402.bankr.bot/0x4b19ee2a3de2521a3adc901989944c209c0a60ea/vates
# The shared secret the gateway sends as `x-bankr-secret`, set as
# VATES_BACKEND_SECRET on the Bankr endpoint too. NOT optional here, whatever
# the gateway's own docs say it is: the gateway also sends `x-402-payer`, and
# if carrying that header were enough to be served, anyone could set it and
# walk through the payment wall. Unset means there is no trusted gateway path
# -- harmless in launch mode, a 402 that gateway callers cannot fix once
# PRICING_MODE=paid. 32+ random chars; `npm run secrets` will make one.
VATES_BACKEND_SECRET=

# Door 2: this origin speaking the `exact` scheme itself, for callers that
# would rather pay us than a gateway. Two candidates, and the check decides:
#
#   https://x402.org/facilitator      Coinbase's standard open facilitator
#   https://api.bankr.bot/facilitator what Bankr's own hosted endpoints
#                                     advertise in their 402 bodies --
#                                     documented as the facilitator behind
#                                     THOSE endpoints, not as an open one, so
#                                     whether it settles for this origin is a
#                                     question to ask rather than assume
#
# Empty means the `exact` scheme is not advertised at all and the 402 says why,
# which is a deliberate silence rather than a broken promise.
#   npm run x402:check                                        # what it settles
#   npm run x402:check -- https://x402.org/facilitator        # try one first
#   npm run x402:check -- https://api.bankr.bot/facilitator
X402_FACILITATOR_URL=
# Optional. Sent as x-api-key, for a facilitator that requires a key.
X402_FACILITATOR_KEY=
# Network slug as the facilitator names it, not a chain id.
X402_NETWORK=base
# Protocol version advertised to an unpaid caller. The published spec is 1;
# Bankr's hosted endpoints emit 2. A payer's own version is never overridden --
# whatever a payment payload declares is what the facilitator is asked to
# verify -- so this only decides what a 402 tells someone to speak.
# X402_VERSION=1
# Public base URL. A payment is bound to an absolute resource URL, so a
# relative one would let the same authorization be replayed against another
# deployment of this code.
X402_RESOURCE_BASE=https://oracle.sb4s.xyz
# X402_MAX_TIMEOUT_SECONDS=120
# X402_FACILITATOR_TIMEOUT_MS=10000
# The token's EIP-712 domain is read off the contract at boot. Set these two
# only to pin them when the read cannot be made.
# X402_ASSET_NAME=
# X402_ASSET_VERSION=

# Model-written replies on the /ask fallback path only -- never replacing a
# deterministic answer. Defaults to 'pro': a subscriber gets one without an
# operator enabling it first. 'all' opens it to everyone; 'off' is a kill
# switch that silences the model for subscribers too. verifyDraft still
# rejects any number not in the curated facts, so it cannot state a figure it
# was not given.
ASK_LLM_MODE=pro

# ---- Agent identity ----
# The account that speaks for the service. Kept in config so the landing page,
# the skill and the model's own introduction cannot drift apart.
AGENT_NAME=Vates
AGENT_FARCASTER_HANDLE=vates

# ---- Operator panel ----
# NOT configured here. The wallet-scoped Bankr key, the admin session secret
# and the owner allowlist live in .env.admin, which only `npm run admin`
# reads. Keeping them out of this file is the point: the public server
# refuses to boot if BANKR_API_KEY is in its environment. See
# .env.admin.example.
