# Robinhood Chain RPC. Public endpoint works but is rate-limited and caps
# eth_getLogs at ~1000 blocks -- backfill on it is impractical.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Strongly recommended for backfill. Alchemy is RH's recommended provider.
# RH_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional second endpoint; used as failover on read errors.
RH_RPC_FALLBACK_URL=https://rpc.mainnet.chain.robinhood.com

# Max blocks per eth_getLogs call. Public RPC rejects >1000.
RH_LOG_CHUNK=1000

# SQLite path for v1. Swap for Postgres later via src/db.
DB_PATH=./data/oracle.db

# API
PORT=8080

# ---- Phase 3: public agent ----
# Bankr LLM Gateway (Anthropic-format). Used ONLY to phrase a post; never in
# the data path. Without a key the agent falls back to deterministic templates.
BANKR_LLM_BASE_URL=https://llm.bankr.bot
BANKR_LLM_API_KEY=
BANKR_LLM_MODEL=claude-sonnet-5

# Channels to queue drafts for (csv): farcaster,x
AGENT_CHANNELS=farcaster

# Recorded against every approval so the queue shows who authorised a post.
AGENT_APPROVER=

# Farcaster via Neynar. Publishing also requires an approved post AND --live.
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=

# X / Twitter (OAuth 1.0a). Publisher is not implemented yet; dry run only.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---- RPC via Alchemy ----
# Expanded into https://robinhood-mainnet.g.alchemy.com/v2/<key> when
# RH_RPC_URL is not set. Needed for any genesis backfill.
ALCHEMY_API_KEY=

# ---- Blockscout: second data source ----
# Backfill path that does not depend on Alchemy, plus holder counts and token
# metadata that no RPC call returns. Never a pricing input.
BLOCKSCOUT_BASE_URL=https://robinhoodchain.blockscout.com
BLOCKSCOUT_API_KEY=
# Min ms between explorer calls; raised automatically on 429.
BLOCKSCOUT_MIN_INTERVAL_MS=120

# FID of the agent's own Farcaster account. Needed to read mentions; replies
# still require approval and --live like any other post.
NEYNAR_AGENT_FID=

# Bind address. Leave unset for local dev (all interfaces). Production sets
# 127.0.0.1 so the reverse proxy is the only way in.
# HOST=127.0.0.1

# ---- Pricing ----
# 'launch' serves every route without charge while still publishing what it
# will cost. 'paid' only once a payment path is actually wired up.
PRICING_MODE=launch
# Stable per-install salt for hashing caller addresses in the usage counter.
# Set it once; changing it resets caller identity, not the counts.
USAGE_SALT=

# Header carrying the true client address when a CDN sits in front, e.g.
# cf-connecting-ip behind Cloudflare. Only honoured when set -- a forwarded
# header is caller-controlled, so it is never trusted by default. Restrict the
# reverse proxy to the CDN's ranges as well.
TRUSTED_CLIENT_IP_HEADER=
