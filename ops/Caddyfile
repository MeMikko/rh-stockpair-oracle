# TLS terminator and the only public route to the API.
#
# Caddy gets certificates automatically, so the box needs 80 and 443 open and
# nothing else. The API itself listens on 127.0.0.1:8080 (HOST in the unit
# file), which is what keeps port 8080 off the internet.
#
# Replace the hostname before deploying.
#
# No domain yet? Use an sslip.io name, which resolves to the IP encoded in it
# and which Let's Encrypt will issue a certificate for:
#
#   203-0-113-10.sslip.io {
#
# That is fine for bringing the stack up and testing it end to end. It is NOT
# fine for the published skill: the hostname contains the IP, so the URL breaks
# if the box ever moves -- and fixing it means another PR to the skills repo.
# Get a real name before submitting anything that names this host.

oracle.example.com {
	encode zstd gzip

	# Every endpoint is a read. Rate limiting is deliberately generous --
	# the point of this service is that other agents call it -- but not
	# unbounded, because /quote and /prepare-swap each cost an RPC round
	# trip and the upstream is rate limited itself.
	@expensive path /quote /prepare-swap /gas
	rate_limit @expensive {
		zone expensive {
			key {remote_host}
			events 60
			window 1m
		}
	}

	rate_limit {
		zone all {
			key {remote_host}
			events 600
			window 1m
		}
	}

	reverse_proxy 127.0.0.1:8080 {
		health_uri /health
		health_interval 30s
	}

	log {
		output file /var/log/caddy/oracle.log
		format json
	}
}
