# Operator panel only. Read by `npm run admin`, and by nothing else.
#
# This file holds the credential that can sign, transfer and launch tokens.
# It is loaded AFTER .env, and no variable may appear in both: the public
# units read .env alone, and rh-oracle-api refuses to start if BANKR_API_KEY
# reaches it.
#
#   npm run secrets -- --admin        # fills ADMIN_AUTH_SECRET
#   sudo chmod 600 /opt/rh-oracle/.env.admin

# The wallet / agent / token-launch key. ADMIN BOX ONLY.
# bankr.bot/api-keys: Wallet API on, Read Only off, IP allowlist set to this
# box. Leave Agent API off unless something actually prompts the agent.
# Verify what it can really do with: npm run bankr:scope
BANKR_API_KEY=

# Signs operator-panel sessions. Deliberately NOT the same value as
# AUTH_SECRET: a session minted by the public site must not be a valid admin
# session. Generated by `npm run secrets -- --admin`.
ADMIN_AUTH_SECRET=

# Addresses allowed to open the panel, comma separated. Empty means the panel
# refuses to start -- there is no "anyone who signs in" mode. Use the address
# you will actually sign with in the browser, not the agent's own wallet.
ADMIN_ADDRESSES=

# Shown in the message you sign, so it is obvious which panel you are
# authorising. Any stable name will do; it is not resolved.
# ADMIN_DOMAIN=oracle-admin.local

# Loopback by default. Reach it with:  ssh -L 8090:127.0.0.1:8090 <box>
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8090

# Binding off loopback needs this set explicitly, and something else keeping
# the port private (Tailscale, a firewall). The panel is not hardened for the
# open internet; that it is unreachable from it IS the security story.
# ADMIN_ALLOW_REMOTE=1

# Set only when the panel is served over TLS rather than an ssh tunnel. Over a
# tunnel it is plain http on localhost, where a Secure cookie is never sent
# and the login just appears to fail.
# ADMIN_SECURE_COOKIE=1
